    "chrome:mcp": "bun packages/tinker-chrome/src/cli.ts mcp",
    "tinker": "bun src/cli/index.ts",
    "check": "bun run typecheck && bun run format:check && bun run lint && bun test && bun run bench:smoke",
    "format": "biome format --write .",
