{
  "manifest_version": 3,
  "name": "Tinker Chrome",
  "description": "A local bridge that lets Tinker observe and control Chrome pages.",
  "version": "0.2.0",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
